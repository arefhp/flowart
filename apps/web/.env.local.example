# apps/web/.env.local.example
#
# Copy to apps/web/.env.local (npm run setup does this and never overwrites an existing file).
# .env.local is git-ignored. Everything here is NON-SECRET: values starting with NEXT_PUBLIC_ are
# shipped to every visitor's browser, so NEVER put a secret in this file.
# Legend: REQUIRED = needed to boot. OPTIONAL = has a safe default.

# ---------------------------------------------------------------------------
# Frontend (public, ends up in the browser)
# ---------------------------------------------------------------------------
# REQUIRED (local, production). Public address of the website, used for canonical links, the
# sitemap and Open Graph. Local: http://localhost:3000. Production: https://zfadavi.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED. Turnstile SITE key (public). Local: Cloudflare's always-pass TEST key below; with it
# the spam-check script is not loaded, so local development works offline. Production: Cloudflare
# -> Turnstile -> widget zakereh-art -> Site key (set it as the GitHub Actions variable
# NEXT_PUBLIC_TURNSTILE_SITE_KEY). Example format: 0x4AAAAAAA...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---------------------------------------------------------------------------
# Build time (read by `next build` / `next dev` on your machine, not sent to the browser)
# ---------------------------------------------------------------------------
# REQUIRED to build. The API the static site is generated from. Local: the Worker on :8787.
# CI and production builds use https://zfadavi.com (the build fails loudly if it is unreachable).
BUILD_API_BASE_URL=http://localhost:8787

# OPTIONAL. Set to 1 ONLY for the very first deploy, before any API exists, to allow an empty site.
# ALLOW_EMPTY_BUILD=1

# OPTIONAL. Where `next dev` proxies /api/* to. Default http://localhost:8787
# DEV_API_ORIGIN=http://localhost:8787
